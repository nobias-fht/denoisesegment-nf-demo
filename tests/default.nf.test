nextflow_pipeline {

    name "Test denoise and segment pipeline"
    script "../main.nf"
    tag "pipeline"

    test("denoise and segment nf-core microscopy test image") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/careamics/careamics.yaml").exists() },
                { assert path("$outputDir/careamics/predictions/nuclear_image.tiff").exists() },
                { assert path("$outputDir/segmentations/nuclear_image_cp_masks.tif").exists() },
                { assert path("$outputDir/pipeline_info/denoisesegment_software_versions.yml").exists() },
            )
        }
    }
}
