/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run nobias-fht/denoisesegment-nf-demo -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Extended microscopy test dataset to check pipeline function'

    input                    = params.pipelines_testdata_base_path + 'modules/data/imaging/segmentation/nuclear_image.tif'
    careamics_axes           = 'YX'
    careamics_patch_size     = '64 64'
    careamics_batch_size     = 4
    careamics_num_epochs     = 2
    careamics_num_steps      = 10
    careamics_n_val_patches  = 2
    careamics_seed           = 42
    careamics_pred_tile_size = '64 64'
}
