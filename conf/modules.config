/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: CAREAMICS_CONFIGN2V {
        ext.args   = [
            params.careamics_num_epochs ? "--num_epochs ${params.careamics_num_epochs}" : "",
            params.careamics_num_steps ? "--num_steps ${params.careamics_num_steps}" : "",
            params.careamics_augmentations ?
                "--augmentations ${params.careamics_augmentations instanceof List ? params.careamics_augmentations.join(' ') : params.careamics_augmentations}"
                : "",
            params.careamics_n_val_patches ? "--n_val_patches ${params.careamics_n_val_patches}" : "",
            params.careamics_use_n2v2 ? "--use_n2v2" : "",
            params.careamics_n_channels ? "--n_channels ${params.careamics_n_channels}" : "",
        ].join(' ').trim()
    }

    withName: CELLPOSE {
        ext.args = [
            params.cellpose_channel_axis ? "--channel_axis ${params.cellpose_channel_axis}" : "",
            params.cellpose_z_axis ? "--z_axis ${params.cellpose_z_axis}" : "",
            params.cellpose_do_3D ? "--do_3D" : ""
        ].join(' ').trim()
    }

}
